---
// Phase 2 Astro Leaflet map component (D-59, D-60).
//
// - Renders a Leaflet map of all Fair Haven parcels (parcels.geojson).
// - Reads ALL JSON files under viz/src/data/overlays/ at build/HMR time
//   via import.meta.glob (eager). Overlays serialized as data-overlays
//   attribute on the map div — read by client-side module script.
// - Daniel's Law (D-65): the GeoJSON shipped here contains NO owner names.
// - Leaflet default-icon fix: vendored marker PNGs at /leaflet/*.
//
// IMPORTANT: client-side script is `<script>` (no define:vars) so Astro
// bundles it as an ES module. `define:vars` ships an INLINE CLASSIC script
// where bare-specifier `import 'leaflet'` doesn't resolve at runtime, which
// silently breaks the map. Vars travel via data-* attributes instead.

const {
  center = [40.3604, -74.0410],
  zoom = 14,
  height = '600px',
} = Astro.props;

const overlayModules = import.meta.glob('/src/data/overlays/*.json', { eager: true });
const overlays: Record<string, Record<string, unknown>> = {};
for (const [path, mod] of Object.entries(overlayModules)) {
  const name = path.split('/').pop()!.replace('.json', '');
  overlays[name] = ((mod as { default?: unknown }).default ?? mod) as Record<string, unknown>;
}
---

<div
  id="parcel-map"
  style={`height:${height};width:100%;`}
  data-center={JSON.stringify(center)}
  data-zoom={String(zoom)}
  data-overlays={JSON.stringify(overlays)}>
</div>

<script>
  // Astro-processed module script. Bundler resolves the leaflet import.
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  const el = document.getElementById('parcel-map');
  if (!el) {
    console.error('[ParcelMap] #parcel-map div not found');
  } else {
    const center = JSON.parse(el.dataset.center || '[40.3604,-74.041]') as [number, number];
    const zoom = parseInt(el.dataset.zoom || '14', 10);
    const overlays = JSON.parse(el.dataset.overlays || '{}') as Record<string, Record<string, unknown>>;

    // Leaflet default-icon URL fix for Astro/Vite static builds.
    // @ts-expect-error mergeOptions accepts these URL keys at runtime
    delete (L.Icon.Default.prototype as any)._getIconUrl;
    L.Icon.Default.mergeOptions({
      iconUrl: '/leaflet/marker-icon.png',
      iconRetinaUrl: '/leaflet/marker-icon-2x.png',
      shadowUrl: '/leaflet/marker-shadow.png',
    });

    const map = L.map('parcel-map').setView(center, zoom);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© OpenStreetMap contributors',
      maxZoom: 19,
    }).addTo(map);

    // Dual-encoding map (D-53 cohorts + tax magnitude):
    //   FILL  = tenure cohort (categorical palette, semantic only)
    //   OUTLINE = last-year tax intensity (single-hue blue sequential —
    //             magnitude only, NOT a moral red/green/yellow scale)
    //
    // Click → dispatch parcel:select event for the drawer.
    // Hover → bump fill opacity + stroke weight, no popup.

    let selectedLyr: any = null;
    const SELECTED_COLOR = '#000000';
    const FALLBACK_FILL = '#cbd5e1'; // slate-300 for parcels w/o data
    const FALLBACK_STROKE = '#94a3b8'; // slate-400

    // Cohort fill palette — categorical, distinct hues, no good/bad coding.
    // pre_2015 + never_sold lean amber/sienna (long-tenured = warm earth);
    // mid-decade = teal; pandemic eras = purple/rose (post-COVID waves).
    // Red → green sequential cohort palette, MAX punch. Saturated primaries.
    const COHORT_FILL: Record<string, string> = {
      no_deed_since_1989:              '#ff0000', // pure red (oldest)
      tenure_pre_2015:                 '#ff8800', // pure orange
      tenure_2015_2019:                '#ffe600', // pure yellow
      tenure_pandemic_2020_2022:       '#88dd00', // lime-green
      tenure_post_pandemic_2023plus:   '#00cc44', // vivid green (newest)
    };
    const COHORT_LABEL: Record<string, string> = {
      no_deed_since_1989:              'No deed since 1989',
      tenure_pre_2015:                 'Last transfer pre-2015',
      tenure_2015_2019:                'Last transfer 2015–2019',
      tenure_pandemic_2020_2022:       'Last transfer 2020–2022 (pandemic)',
      tenure_post_pandemic_2023plus:   'Last transfer 2023+ (post-pandemic)',
    };

    // Outline tax palette — single-hue sequential blue (light → dark).
    // Magnitude scale only: more tax paid = darker outline. No "good/bad".
    const TAX_PALETTE = [
      '#deebf7', '#c6dbef', '#9ecae1', '#6baed6',
      '#4292c6', '#2171b5', '#08306b'
    ];

    function makeQuantileFn(values: number[], palette: string[]): (v: number | null | undefined) => string {
      const sorted = values.filter((v) => Number.isFinite(v) && v > 0).sort((a, b) => a - b);
      if (sorted.length === 0) return () => palette[0];
      const stops = palette.length;
      const breaks: number[] = [];
      for (let i = 1; i < stops; i++) {
        const q = i / stops;
        breaks.push(sorted[Math.floor(q * sorted.length)]);
      }
      return (v) => {
        if (!Number.isFinite(v as number) || (v as number) <= 0) return palette[0];
        for (let i = 0; i < breaks.length; i++) {
          if ((v as number) <= breaks[i]) return palette[i];
        }
        return palette[stops - 1];
      };
    }

    function styleFor(fill: string, stroke: string, isHover = false, isSelected = false) {
      if (isSelected) {
        return { color: SELECTED_COLOR, weight: 3.5, fillColor: fill, fillOpacity: 0.55 };
      }
      if (isHover) {
        return { color: stroke, weight: 3, fillColor: fill, fillOpacity: 0.45 };
      }
      return { color: stroke, weight: 1.5, fillColor: fill, fillOpacity: 0.30 };
    }

    Promise.all([
      fetch('/data/parcels.geojson').then((r) => r.json()),
      fetch('/data/parcels_full.json').then((r) => (r.ok ? r.json() : {})).catch(() => ({})),
    ])
      .then(([gj, fullData]) => {
        // Per-parcel: tax magnitude + cohort tag + renovation tier.
        const taxByPin: Record<string, number> = {};
        const cohortByPin: Record<string, string> = {};
        const renoByPin: Record<string, { tier: string; year: number | null }> = {};
        for (const [pin, rec] of Object.entries(fullData) as Array<[string, any]>) {
          const t = rec?.current_assessment?.last_year_tax;
          if (Number.isFinite(t) && t > 0) taxByPin[pin] = t;
          const c = rec?.cohort?.cohort;
          if (c) cohortByPin[pin] = c;
          const r = rec?.renovations;
          if (r && (r.tier === 'high' || r.tier === 'medium')) {
            renoByPin[pin] = { tier: r.tier, year: r.last_event_year ?? null };
          }
        }
        const taxColorFn = makeQuantileFn(Object.values(taxByPin), TAX_PALETTE);
        const strokeByPin: Record<string, string> = {};
        for (const pin of Object.keys(taxByPin)) {
          strokeByPin[pin] = taxColorFn(taxByPin[pin]);
        }

        const layer = L.geoJSON(gj, {
          style: (f: any) => {
            const pin = f?.properties?.pams_pin;
            const fill = COHORT_FILL[cohortByPin[pin]] || FALLBACK_FILL;
            const stroke = strokeByPin[pin] || FALLBACK_STROKE;
            return styleFor(fill, stroke);
          },
          onEachFeature: (feature, lyr) => {
            const props = (feature.properties || {}) as Record<string, any>;
            const pin = props.pams_pin;
            const fill = COHORT_FILL[cohortByPin[pin]] || FALLBACK_FILL;
            const stroke = strokeByPin[pin] || FALLBACK_STROKE;
            lyr.on('mouseover', () => {
              if (lyr !== selectedLyr) (lyr as any).setStyle(styleFor(fill, stroke, true));
            });
            lyr.on('mouseout', () => {
              if (lyr !== selectedLyr) (lyr as any).setStyle(styleFor(fill, stroke));
            });
            lyr.on('click', () => {
              if (selectedLyr && selectedLyr !== lyr) {
                const prevPin = (selectedLyr as any).feature?.properties?.pams_pin;
                const prevFill = COHORT_FILL[cohortByPin[prevPin]] || FALLBACK_FILL;
                const prevStroke = strokeByPin[prevPin] || FALLBACK_STROKE;
                (selectedLyr as any).setStyle(styleFor(prevFill, prevStroke));
              }
              selectedLyr = lyr;
              (lyr as any).setStyle(styleFor(fill, stroke, false, true));
              window.dispatchEvent(
                new CustomEvent('parcel:select', { detail: { pin, props } })
              );
            });
          },
        }).addTo(map);

        try {
          const b = layer.getBounds();
          if (b.isValid()) map.fitBounds(b, { padding: [20, 20] });
        } catch (_) {
          /* keep default view */
        }

        // Renovation overlay — small circle markers at high/medium-tier parcel
        // centroids. Toggleable via Leaflet layer-control. High = solid black ring,
        // medium = lighter. Year label on hover.
        const renoLayer = L.layerGroup();
        let renoCount = 0;
        for (const f of (gj.features || []) as any[]) {
          const pin = f?.properties?.pams_pin;
          const r = renoByPin[pin];
          if (!r) continue;
          let cx = 0, cy = 0, n = 0;
          const accum = (coords: any) => {
            if (typeof coords[0] === 'number') {
              cx += coords[0]; cy += coords[1]; n++;
            } else { for (const c of coords) accum(c); }
          };
          try { accum(f.geometry.coordinates); } catch (_) { continue; }
          if (n === 0) continue;
          const lat = cy / n;
          const lng = cx / n;
          const isHigh = r.tier === 'high';
          const m = L.circleMarker([lat, lng], {
            radius: isHigh ? 5 : 3.5,
            color: '#0e1116',
            weight: isHigh ? 2 : 1.5,
            fillColor: isHigh ? '#0a7c2f' : '#0a7caa',
            fillOpacity: 0.85,
          });
          const yearStr = r.year ? ` · ${r.year}` : '';
          m.bindTooltip(`Renovation: ${r.tier}${yearStr}`, { direction: 'top', offset: [0, -4] });
          renoLayer.addLayer(m);
          renoCount++;
        }
        renoLayer.addTo(map);
        // Layer control: lets user toggle renovation overlay off
        (L as any).control.layers(undefined, {
          [`Renovations (${renoCount})`]: renoLayer,
        }, { collapsed: false, position: 'topright' }).addTo(map);

        // Dual-scale legend (bottom-right): tenure cohort fill + tax outline.
        const legend = (L as any).control({ position: 'bottomright' });
        legend.onAdd = () => {
          const div = (L as any).DomUtil.create('div', 'pd-heatmap-legend');
          const sortedTax = Object.values(taxByPin).filter((v) => v > 0).sort((a, b) => a - b);
          const pct = (q: number) => sortedTax[Math.floor(q * sortedTax.length)] || 0;
          const fmt = (n: number) => '$' + Math.round(n / 1000) + 'K';
          // Cohort counts
          const cohortCounts: Record<string, number> = {};
          for (const c of Object.values(cohortByPin)) cohortCounts[c] = (cohortCounts[c] || 0) + 1;

          const cohortRows = [
            'no_deed_since_1989',
            'tenure_pre_2015',
            'tenure_2015_2019',
            'tenure_pandemic_2020_2022',
            'tenure_post_pandemic_2023plus',
          ]
            .map((c) => {
              const n = cohortCounts[c] || 0;
              const fill = COHORT_FILL[c];
              return `<div style="display:flex;align-items:center;gap:6px;margin-bottom:1px"><span style="display:inline-block;width:18px;height:11px;background:${fill};opacity:0.55;border:1px solid #555"></span><span style="flex:1">${COHORT_LABEL[c]}</span><span style="color:#5b6270;font-variant-numeric:tabular-nums">${n}</span></div>`;
            })
            .join('');

          const taxRows = TAX_PALETTE.map((c, i) => {
            const lo = i === 0 ? 0 : pct(i / TAX_PALETTE.length);
            const hi = i === TAX_PALETTE.length - 1 ? sortedTax[sortedTax.length - 1] : pct((i + 1) / TAX_PALETTE.length);
            return `<div style="display:flex;align-items:center;gap:6px"><span style="display:inline-block;width:18px;height:0;border-top:3px solid ${c}"></span>${fmt(lo)} – ${fmt(hi)}</div>`;
          }).join('');

          div.innerHTML =
            '<div style="background:rgba(255,255,255,0.97);padding:8px 10px;border:1px solid #c8cdd4;border-radius:5px;font:11px/1.45 system-ui,-apple-system,sans-serif;color:#0e1116;box-shadow:0 2px 6px rgba(0,0,0,0.12);min-width:230px">' +
            '<div style="font-weight:700;font-size:11px;margin-bottom:4px;text-transform:uppercase;letter-spacing:0.04em;color:#5b6270">Fill: tenure cohort</div>' +
            cohortRows +
            '<div style="font-weight:700;font-size:11px;margin:8px 0 4px;text-transform:uppercase;letter-spacing:0.04em;color:#5b6270">Outline: last-year tax</div>' +
            taxRows +
            `<div style="margin-top:6px;color:#5b6270;font-size:10px;border-top:1px solid #e3e6ea;padding-top:4px">${Object.keys(cohortByPin).length} parcels classified · ${sortedTax.length} with tax data</div>` +
            '</div>';
          return div;
        };
        legend.addTo(map);
      })
      .catch((err) => console.error('[ParcelMap] data load failed:', err));
  }
</script>
