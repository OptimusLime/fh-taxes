---
// Standalone per-parcel detail page. Server-renders <ParcelDetail> so
// `curl /parcel/<pin>` returns the full styled HTML — useful for screenshot
// review, deep-linking, and print/PDF export later.
//
// At dev time we read parcels_full.json from the filesystem on each request.
// For static build, getStaticPaths enumerates the same JSON and emits one
// route per PIN.

import fs from 'node:fs';
import path from 'node:path';
import ParcelDetail from '../../components/parcel/ParcelDetail';
import '../../components/parcel/parcel.css';

const DATA_PATH = path.resolve('./src/data/parcels_full.json');

function loadAll(): Record<string, any> {
  const raw = fs.readFileSync(DATA_PATH, 'utf-8');
  return JSON.parse(raw);
}

export async function getStaticPaths() {
  const fullPath = path.resolve('./src/data/parcels_full.json');
  if (!fs.existsSync(fullPath)) return [];
  const data = JSON.parse(fs.readFileSync(fullPath, 'utf-8'));
  return Object.entries(data).map(([pin, record]) => ({
    params: { pin },
    props: { record },
  }));
}

const { pin } = Astro.params;
let record: any = (Astro.props as any).record;
// In dev mode props may not flow through getStaticPaths; load on-demand.
if (!record && pin) {
  try {
    record = loadAll()[pin];
  } catch {
    record = null;
  }
}

const propertyLocation = record?.identity?.property_location ?? pin;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{propertyLocation} · {pin}</title>
    <style>
      body {
        margin: 0; padding: 0;
        background: #f6f7f9;
        font-family: -apple-system, system-ui, sans-serif;
      }
      .page-back {
        max-width: 980px; margin: 0 auto;
        padding: 0.6rem 1rem;
      }
      .page-back a {
        color: #1a56db; text-decoration: none; font-size: 0.9rem;
      }
      .page-back a:hover { text-decoration: underline; }
      .page-card {
        max-width: 980px; margin: 0 auto 2rem;
        background: #fff; border: 1px solid #e3e6ea; border-radius: 8px;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
      }
      .pd-page { max-width: none !important; padding: 0 !important; }
      .pd-page > .pd-header { padding: 1.25rem 1.5rem 1rem !important; }
      .pd-page > .pd-section { padding: 1.25rem 1.5rem !important; }
    </style>
  </head>
  <body>
    <div class="page-back">
      <a href="/">← Back to map</a>
    </div>
    <div class="page-card">
      {record ? (
        <ParcelDetail pin={pin!} record={record} variant="page" />
      ) : (
        <div style="padding: 3rem; text-align: center; color: #5b6270;">
          No record found for parcel <strong>{pin}</strong>.
        </div>
      )}
    </div>
  </body>
</html>
