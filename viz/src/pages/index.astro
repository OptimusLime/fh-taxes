---
import ParcelMap from '../components/ParcelMap.astro';
import DrawerApp from '../components/parcel/DrawerApp.tsx';
import '../components/parcel/parcel.css';

const pages = [
  { href: '/purpose', label: 'Purpose' },
  { href: '/town-composition', label: 'Town Composition' },
  { href: '/data-quality', label: 'Data Quality (Plan 1)' },
  { href: '/hedonic', label: 'Hedonic OLS (Plan 4)' },
  { href: '/tax-shift', label: 'Berry Tax Shift (Plan 5)' },
  { href: '/ratio-study', label: 'IAAO Ratio Study (Plan 6)' },
  { href: '/cdf-gap-test', label: 'CDF Gap Test (Plan 7)' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Fair Haven Tax Assessment Analysis</title>
    <style>
      :root {
        --drawer-w: 580px;
        --shell-bg: #ffffff;
        --shell-fg: #0e1116;
        --shell-muted: #5b6270;
        --shell-border: #e3e6ea;
        --shell-accent: #1a56db;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; height: 100%; }
      body {
        font-family: -apple-system, system-ui, sans-serif;
        color: var(--shell-fg);
        background: var(--shell-bg);
        overflow: hidden;
      }
      .topbar {
        display: flex; align-items: center; justify-content: space-between;
        padding: 0.5rem 1rem; border-bottom: 1px solid var(--shell-border);
        height: 48px;
      }
      .topbar h1 { font-size: 1rem; margin: 0; font-weight: 600; }
      .topbar nav a {
        margin-left: 1rem; font-size: 0.85rem; color: var(--shell-accent);
        text-decoration: none;
      }
      .topbar nav a:hover { text-decoration: underline; }

      .layout {
        display: grid;
        grid-template-columns: 1fr 0px;
        height: calc(100vh - 48px);
        transition: grid-template-columns 200ms ease;
      }
      .layout.drawer-open {
        grid-template-columns: 1fr var(--drawer-w);
      }

      .map-pane { position: relative; overflow: hidden; }
      .map-pane :global(#parcel-map) { width: 100%; height: 100% !important; }

      .drawer-shell {
        background: var(--shell-bg);
        border-left: 1px solid var(--shell-border);
        overflow-y: auto;
        overflow-x: hidden;
        position: relative;
      }
      .drawer-close {
        position: absolute; top: 0.5rem; right: 0.5rem;
        background: rgba(255, 255, 255, 0.9); border: 1px solid var(--shell-border);
        border-radius: 4px; width: 28px; height: 28px; cursor: pointer; line-height: 1;
        font-size: 1.05rem; z-index: 10;
      }
      .drawer-close:hover { background: #f0f1f3; }
    </style>
  </head>
  <body>
    <div class="topbar">
      <h1>Fair Haven Tax Assessment Analysis — Phase 2</h1>
      <nav>
        {pages.map((p) => <a href={p.href}>{p.label}</a>)}
      </nav>
    </div>

    <div class="layout" id="layout">
      <div class="map-pane">
        <ParcelMap height="100%" />
      </div>

      <aside class="drawer-shell" id="drawer" aria-hidden="true">
        <button class="drawer-close" id="drawer-close" aria-label="Close drawer">×</button>
        <DrawerApp client:load />
      </aside>
    </div>
  </body>
</html>
